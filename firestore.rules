rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == "thales.market@gmail.com" && request.auth.token.email_verified == true;
    }

    function isValidResponse(data) {
      return data.keys().hasAll(['firstName', 'lastName', 'email', 'phone', 'submittedAt']) &&
             data.firstName is string && data.firstName.size() <= 100 &&
             data.lastName is string && data.lastName.size() <= 100 &&
             data.email is string && data.email.size() <= 200 &&
             data.phone is string && data.phone.size() <= 50;
    }

    match /responses/{responseId} {
      // Anyone can submit a response
      allow create: if isValidResponse(request.resource.data);
      
      // Only admin can read responses
      allow read: if isAdmin();
      
      // No updates or deletes allowed for now unless by admin
      allow update, delete: if isAdmin();
    }
  }
}
